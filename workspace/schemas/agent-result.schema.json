{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local agent handoff v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "packetId", "disposition", "summary", "limitations", "nextAction", "outputs", "checks", "gates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "packetId": {"type": "string", "pattern": "^packet_[0-9a-f]{24}$"},
    "disposition": {"enum": ["review", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 3000},
    "limitations": {"type": "string", "minLength": 1, "maxLength": 3000},
    "nextAction": {"type": "string", "minLength": 1, "maxLength": 3000},
    "outputs": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }}},
    "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "command", "result", "evidence"], "properties": {
      "name": {"type": "string", "minLength": 1, "maxLength": 3000}, "status": {"enum": ["passed", "failed", "not-run"]}, "command": {"type": "string", "minLength": 1, "maxLength": 3000}, "result": {"type": "string", "minLength": 1, "maxLength": 3000}, "evidence": {"type": "array", "items": {"type": "string"}}
    }}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["implementation", "validation", "anatomy", "userAcceptance"], "properties": {
      "implementation": {"enum": ["changed", "unchanged"]}, "validation": {"enum": ["passed", "partial", "not-run"]}, "anatomy": {"enum": ["not-assessed", "unresolved"]}, "userAcceptance": {"const": "not-assessed"}
    }}
  },
  "$comment": "Python also checks canonical relative paths, unique IDs/paths, hashes, check evidence references, review readiness, source identity and transactional work revisions."
}
