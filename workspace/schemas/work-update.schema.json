{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace work update V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectedRevision",
    "status",
    "owner",
    "rationale",
    "evidence",
    "expectedSnapshot"
  ],
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ready",
        "active",
        "blocked",
        "review",
        "done"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      }
    },
    "expectedSnapshot": {
      "type": "string",
      "pattern": "^snapshot_[a-f0-9]{16}$"
    }
  },
  "$comment": "Runtime additionally checks dependencies, current revision, artifact identity/availability and nonempty completion evidence. It never changes review gates."
}
